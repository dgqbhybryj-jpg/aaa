{
  "version": 2,
  "builds": [
    {
      "src": "api/analyze.py",
      "use": "@vercel/python"
    },
    {
      "src": "static/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "static/script.js",
      "use": "@vercel/static"
    },
    {
      "src": "static/style.css",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/api/analyze",
      "dest": "api/analyze.py"
    },
    {
      "src": "/",
      "dest": "/static/index.html"
    }
  ]
}