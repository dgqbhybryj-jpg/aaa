{
  "version": 2,
  "builds": [
    { "src": "api/analyze.py", "use": "@vercel/python" },
    { "src": "static/**", "use": "@vercel/static" }
  ],
  "rewrites": [
    {
      "source": "/api/analyze",
      "destination": "/api/analyze.py"
    },
    {
      "source": "/api/text_to_speech",
      "destination": "/api/text_to_speech.py"
    },
    { "source": "/(.*)", "destination": "/static/$1" }
  ],
  "headers": [
    {
      "source": "/static/(.*)\\.(js|css)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}